+/// Fixed keys and saturating counts keep profiling storage bounded. The launch
+/// environment is read once; disabled profiling never populates the dictionary.
+@MainActor
+struct GhosttyTerminalProfileCounters {
+    enum Counter: String {
+        case hostTicks = "host_ticks"
+        case viewRenderRequests = "view_render_requests"
+        case viewUpdateLayerCalls = "view_update_layer_calls"
+        case viewPreeditUpdates = "view_preedit_updates"
+        case viewPreeditClears = "view_preedit_clears"
+        case viewUnmarkNoops = "view_unmark_noops"
+        case sessionRenderRequests = "session_render_requests"
+        case surfaceDrawCalls = "surface_draw_calls"
+        case asyncRenderRefreshes = "async_render_refreshes"
+        case effectiveResizes = "effective_resizes"
+        case resizeNoops = "resize_noops"
+        case contentScaleChanges = "content_scale_changes"
+        case contentScaleNoops = "content_scale_noops"
+        case layerScaleChanges = "layer_scale_changes"
+        case colorSchemeChanges = "color_scheme_changes"
+        case colorSchemeNoops = "color_scheme_noops"
+        case focusCalls = "focus_calls"
+        case focusNoops = "focus_noops"
+        case occlusionChanges = "occlusion_changes"
+        case occlusionNoops = "occlusion_noops"
+        case inputRefreshes = "input_refreshes"
+        case keyDownRefreshes = "key_down_refreshes"
+        case keyUpRefreshes = "key_up_refreshes"
+        case textRefreshes = "text_refreshes"
+        case preeditRefreshes = "preedit_refreshes"
+        case preeditSets = "preedit_sets"
+        case preeditClears = "preedit_clears"
+    }
+
+    private static let enabled = ProcessInfo.processInfo.environment["F7TTY_PROFILE"] == "1"
+    private(set) var snapshot: [String: Int] = [:]
+
+    mutating func record(_ counter: Counter) {
+        guard Self.enabled else { return }
+        let value = snapshot[counter.rawValue, default: 0]
+        if value < Int.max {
+            snapshot[counter.rawValue] = value + 1
+        }
+    }
+}
 
